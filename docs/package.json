{
  "name": "wink-docs",
  "version": "1.0.0",
  "description": "Documentation for Wink WASM demo",
  "scripts": {
    "copy-wasm": "node .vuepress/scripts/copy-wasm.js",
    "build-wasm": "cd .. && wasm-pack build --target web",
    "docs:dev": "node .vuepress/scripts/dev.js",
    "docs:build": "node .vuepress/scripts/copy-wasm.js && vuepress build",
    "watch-geometry": "node .vuepress/scripts/watch-geometry.js",
    "dev": "npm run build-wasm && npm run docs:dev",
    "build": "npm run build-wasm && npm run docs:build"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "^2.0.0-rc.24",
    "@vuepress/client": "^2.0.0-rc.24",
    "@vuepress/theme-default": "^2.0.0-rc.24",
    "sass-embedded": "^1.89.2",
    "vuepress": "^2.0.0-rc.24"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mdit-vue/plugin-component": "^3.0.2",
    "wink-docs": "file:"
  }
}
